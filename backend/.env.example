# SIH Sonar Backend — Environment Configuration
# Copy this file to .env and adjust as needed.

# Path to the trained YOLOv8 weights file
# Place your best.pt here or override this path
MODEL_PATH=src/models/best.pt

# Fallback: auto-downloaded by ultralytics if best.pt is missing
FALLBACK_MODEL=yolov8n.pt

# Output directory for processed images and reports
OUTPUT_DIR=outputs

# Confidence threshold (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.25

# NMS IoU threshold
IOU_THRESHOLD=0.45

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=500

# Lee filter window size (must be odd integer)
LEE_FILTER_SIZE=7

# Default towfish altitude in metres (used when telemetry is missing)
DEFAULT_ALTITUDE_M=3.0

# Default slant range in metres (used when telemetry is missing)
DEFAULT_SLANT_RANGE_M=30.0
